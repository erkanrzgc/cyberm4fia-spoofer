# ============================================================
# cyberm4fia-spoofer  —  environment configuration
# ============================================================
# copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This file (.env.example) is safe to commit — use example values only.
# ============================================================

# ── session ─────────────────────────────────────────────────
SPOOF_INTERFACE=eth0
SPOOF_LOG_LEVEL=INFO
SPOOF_LOG_FILE=logs/spoof.log
SPOOF_AUTO_FIREWALL=true
SPOOF_RESTORE_ON_EXIT=true
SPOOF_SAVE_STATS=true

# ── dns spoofing defaults ───────────────────────────────────
SPOOF_DNS_ENABLED=true
SPOOF_DNS_MODE=race
SPOOF_DNS_INTERFACE=
SPOOF_DNS_SPOOF_IP=192.168.1.100
SPOOF_DNS_TARGET=*.vulnweb.com
SPOOF_DNS_MATCH_TYPE=wildcard
SPOOF_DNS_TTL=300

# ── arp spoofing defaults ───────────────────────────────────
SPOOF_ARP_ENABLED=true
SPOOF_ARP_INTERFACE=
SPOOF_ARP_INTERVAL=2.0
SPOOF_ARP_GATEWAY=192.168.1.1
SPOOF_ARP_VICTIM=192.168.1.105

# ── webhooks (discord / slack / generic) ────────────────────
# WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghkl
# TELEGRAM_CHAT_ID=-123456789

# ── callbacks (shell commands) ──────────────────────────────
# CALLBACK_DNS_HIT_CMD=notify-send "spoof hit: {domain} -> {spoof_ip}"
# CALLBACK_ARP_SPOOF_CMD=notify-send "arp spoof: {victim}"

# ── plugins ─────────────────────────────────────────────────
# comma-separated plugin names (without .py extension)
# SPOOF_ENABLED_PLUGINS=discord_webhook,my_custom_plugin
# SPOOF_PLUGIN_DIR=plugins
